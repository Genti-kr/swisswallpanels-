# Production Environment — API Server
# Copy to apps/api/.env when deploying (never commit real values)

NODE_ENV=production
PORT=3001

# Database (managed MySQL — e.g. PlanetScale, Hetzner, AWS RDS)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/swisswallpanels?charset=utf8mb4"

# URLs — NO localhost in production
API_URL="https://api.swisswallpanels.ch"
FRONTEND_URL="https://swisswallpanels.ch"

# Auth — generate UNIQUE values per environment (never reuse dev secrets in prod):
#   pnpm generate:secrets -- --write   (local) then copy to VPS/Vercel env dashboard
JWT_SECRET="REPLACE-WITH-48-BYTE-RANDOM-SECRET"
JWT_REFRESH_SECRET="REPLACE-WITH-DIFFERENT-48-BYTE-SECRET"
AUTH_SECRET="REPLACE-WITH-DIFFERENT-48-BYTE-SECRET"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
CONSENT_LOG_SALT="REPLACE-WITH-RANDOM-SALT"

# Admin API access — strongly recommended in production
# ADMIN_IP_WHITELIST="203.0.113.10,198.51.100.5"

# Database seed — never enable demo users in production
SEED_DEMO_USERS="false"

# Stripe (https://dashboard.stripe.com)
# Start with TEST keys, switch to LIVE before go-live
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Postmark (https://account.postmarkapp.com)
POSTMARK_API_KEY="your-server-token"
POSTMARK_FROM="noreply@yourdomain.ch"
ADMIN_EMAIL="info@yourdomain.ch"

# Cloudflare R2 (https://dash.cloudflare.com → R2)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET="swisswallpanels-assets"
R2_PUBLIC_URL="https://cdn.swisswallpanels.ch"

# Optional monitoring (https://sentry.io)
SENTRY_DSN=""
SENTRY_RELEASE="swisswallpanels@1.0.0"
