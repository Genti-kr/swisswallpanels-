# Database Connection
# XAMPP lokal (rekomanduar): root pa fjalëkalim
DATABASE_URL="mysql://root:@localhost:3306/swisswallpanels?charset=utf8mb4"
# Alternativë me user të dedikuar:
# DATABASE_URL="mysql://swisswalluser:swisswallpassword@localhost:3306/swisswallpanels?charset=utf8mb4"

# JWT Security — generate strong values: pnpm generate:secrets -- --write
JWT_SECRET="generate-with-pnpm-generate-secrets"
JWT_REFRESH_SECRET="generate-with-pnpm-generate-secrets"
AUTH_SECRET="generate-with-pnpm-generate-secrets"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
CONSENT_LOG_SALT="generate-with-pnpm-generate-secrets"

# Optional: comma-separated IPs allowed to access /api/admin (leave empty to disable)
# ADMIN_IP_WHITELIST="203.0.113.10,198.51.100.5"

# NextAuth / Auth.js (apps/web)
AUTH_SECRET="your-256-bit-jwt-secret-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Redis Caching
REDIS_URL="redis://localhost:6379"

# Postmark Transactional Email
POSTMARK_API_KEY="your-postmark-api-key"
POSTMARK_FROM="noreply@swisswallpanels.ch"
ADMIN_EMAIL="info@swisswallpanels.ch"

# Stripe Payment Gateway
# Development: sk_test_... / pk_test_... / whsec_... (from `stripe listen`)
# Production: sk_live_... / pk_live_... / whsec_... (Dashboard → Developers → Webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Company legal data (Impressum, AGB) — copy from company.env.example ---
# COMPANY_LEGAL_NAME="..."
# COMPANY_UID="CHE-..."
# See company.env.example for full list

# Database seed (production: keep false)
SEED_DEMO_USERS="false"
ADMIN_SEED_PASSWORD="change-me-before-seeding"
E2E_USER_PASSWORD="change-me-before-seeding"

# Datatrans Swiss Payment Hub (TWINT)
DATATRANS_MERCHANT_ID="your-merchant-id"
DATATRANS_API_KEY="your-key"
DATATRANS_SIGN_KEY="your-sign-key"

# Cloudflare R2 File Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="swisswallpanels-assets"
R2_PUBLIC_URL="https://cdn.swisswallpanels.ch"

# Maintenance mode (storefront shows maintenance page; admin/API stay reachable)
# MAINTENANCE_MODE="true"

# Application Environment
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
CONSENT_LOG_SALT="random-string-for-hashing-consent-ips"

# Next.js Public variables (will be copied to apps/web/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Production CDN (optional in dev)
# NEXT_PUBLIC_R2_PUBLIC_URL="https://cdn.swisswallpanels.ch"
# NEXT_PUBLIC_CDN_HOSTNAME="cdn.swisswallpanels.ch"
# INTERNAL_API_URL="http://localhost:3001"  # web server-side proxy target
