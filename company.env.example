COMPANY_DIRECTOR_ROLE="Geschäftsführer"
COMPANY_UID="CHE-123.456.789"
COMPANY_TRADE_REGISTER="Handelsregister des Kantons Zürich, HRB 123456"

# Optional (sensible defaults exist)
